# The settings the server reads. Nothing reads this file: nothing loads it for you (there is no dotenv step), so a .env copy
# does nothing by itself. Put these names in the environment of the process: your host's settings, `export NAME=value` in the
# shell, a systemd EnvironmentFile or `docker run --env-file`. Then start the real server with `npm run start:api`
# (run `npm run migrate` first, with DATABASE_URL set to the table owner). Never commit real values; real ones come from the host.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/orders
TOKEN_SECRET=CHANGE_ME_to_at_least_32_random_characters
ALLOWED_ORIGINS=http://localhost:5173
MEDIA_DIR=./media
PORT=8787
# TRUST_PROXY=1            (how many reverse proxies are in front: 1, 2 to 10, or a list of proxy addresses; unset or 0 = none)
# LOG_LEVEL=info          (fatal, error, warn, info, debug, trace or silent; info = one short line per request)
# DB_POOL_MAX=5           (database connections, 1 to 50)
# DB_STATEMENT_TIMEOUT_MS=30000   (0 = no limit)
# ALLOW_UNSAFE_DB_ROLE=1  (LOCAL DEVELOPMENT ONLY: start with a superuser / table-owner DATABASE_URL, which turns row-level security off)
# Photos in an S3-compatible bucket instead of a folder (AWS Mumbai, Cloudflare R2, MinIO, Backblaze).
# MEDIA_STORE=s3
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            (optional; not needed for plain AWS)
# S3_FORCE_PATH_STYLE=1   (optional; MinIO needs it)
# S3_PREFIX=photos-pilot  (optional)

# AI suggestions for notes from the floor (English meaning + reason). Leave the keys empty to keep AI off.
# AI_PROVIDER=groq        (groq, gemini or anthropic; unset: whichever key is set)
# GROQ_API_KEY=           (free plan: console.groq.com)
# GEMINI_API_KEY=         (free tier: Google AI Studio)
# ANTHROPIC_API_KEY=
# AI_MODEL=               (optional; defaults openai/gpt-oss-120b / gemini-3.8-flash / claude-opus-5-5)
