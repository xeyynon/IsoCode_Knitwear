{
  "name": "isocode-knitwear",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:pg": "vitest run packages/server",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.scripts.json",
    "check": "node scripts/check_repo.mjs && node scripts/check_docs.mjs && node scripts/check_contrast.mjs && node scripts/check_bugs.mjs",
    "verify": "npm run check && npm run typecheck && npm test",
    "dev:api": "tsx packages/server/src/dev.ts",
    "migrate": "tsx packages/server/src/migrate.ts",
    "seed:demo": "tsx packages/server/src/seedDemoCli.ts",
    "start:api": "tsx packages/server/src/server.ts",
    "build": "npm run build -w @isocode/web",
    "build:vercel": "node scripts/vercel_build.mjs",
    "e2e": "tsx scripts/e2e_offline.ts",
    "snapshots": "tsx scripts/snapshots.ts",
    "a11y": "tsx scripts/a11y.ts",
    "ux": "tsx scripts/ux_metrics.ts && tsx scripts/topbar_metrics.ts",
    "load": "tsx scripts/load_metrics.ts",
    "phone": "tsx scripts/phone_keyboard.ts",
    "diff": "tsx scripts/snapshot_diff.ts"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
