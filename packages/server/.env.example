# Copy to .env (never commit .env). Real values come from the host.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/orders
TOKEN_SECRET=CHANGE_ME_to_at_least_32_random_characters
ALLOWED_ORIGINS=http://localhost:5173
MEDIA_DIR=./media
PORT=8787
# Photos in an S3-compatible bucket instead of a folder (AWS Mumbai, Cloudflare R2, MinIO, Backblaze).
# MEDIA_STORE=s3
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            (optional; not needed for plain AWS)
# S3_FORCE_PATH_STYLE=1   (optional; MinIO needs it)
# S3_PREFIX=photos-pilot  (optional)
